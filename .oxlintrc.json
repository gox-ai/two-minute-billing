{
  "$schema": "./node_modules/oxlint/configuration_schema.json",

  // Two very different halves of one repo share this config:
  //   .          Node/Fastify engine, worker, scripts, sdk — no JSX
  //   dashboard  Next.js 16 + React 19 + Tailwind 4
  // The react/nextjs/tailwind rules only fire on the files that can trigger them,
  // so one root config is enough; a second nested .oxlintrc.json in dashboard/
  // would only mean two places to keep in sync.
  "plugins": ["eslint", "typescript", "react", "nextjs", "oxc", "import", "promise"],
  "jsPlugins": ["oxlint-tailwindcss"],

  "ignorePatterns": [
    // Generated — regenerated by `pnpm sdk:generate`, never hand-edited.
    "sdk/schema.d.ts",
    "sdk/openapi.json",
    // Hand-written SQL + its journal. Not JS, but keeps the walk cheap.
    "db/migrations/**",
    // Build output and machine-local scratch.
    "dashboard/.next/**",
    "scratchpad/**",
    ".parity/**",
    ".reference/**",
    ".claude/**",
    ".tokensave/**"
  ],

  "settings": {
    "tailwindcss": {
      "entryPoint": "dashboard/app/globals.css"
    }
  },

  "rules": {
    // ── Correctness — catch real bugs ────────────────────────────────────────
    //
    // rules-of-hooks is not on by default. A hook placed after an early return
    // gives the two renders different hook counts, React matches them
    // positionally to the wrong slots, and the failure shows up as a console
    // warning rather than a build error — exactly the kind of thing that ships.
    "react-hooks/rules-of-hooks": "error",
    // A browser global used as a bare name is a missing variable that type-checks: `focus`
    // read an undeclared prop as `window.focus` (always truthy) and threw on the server.
    "no-restricted-globals": [
      "error",
      "focus",
      "blur",
      "close",
      "open",
      "name",
      "status",
      "event",
      "top",
      "self",
      "length",
      "origin",
      "history",
      "stop",
      "print",
      "find"
    ],
    // Two classes on one element that set the same CSS property: whichever wins
    // is decided by Tailwind's own output order, not by the order you wrote
    // them, so the one you meant is a coin flip.
    "tailwindcss/no-conflicting-classes": "error",
    "tailwindcss/no-deprecated-classes": "error",
    "tailwindcss/no-duplicate-classes": "warn",

    // ── Modernization — keep classes in current canonical form ───────────────
    "tailwindcss/enforce-canonical": "warn",
    "tailwindcss/no-unnecessary-arbitrary-value": "warn",

    // ── Style and consistency ───────────────────────────────────────────────
    "tailwindcss/enforce-sort-order": "warn",
    "tailwindcss/consistent-variant-order": "warn",
    "tailwindcss/enforce-consistent-important-position": "warn",
    "tailwindcss/no-unnecessary-whitespace": "warn"

    // NOT enabled: tailwindcss/no-unknown-classes. Our design system defines its
    // own utilities in dashboard/app/globals.css and the rule flags them until
    // every one is taught to it — see the `ui` skill for the token list.
  }
}
