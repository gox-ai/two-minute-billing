{
  "$schema": "https://tmbilling.dev/architecture.schema.json",
  "name": "tmbilling",
  "description": "Module dependency + data-flow graph for the tmbilling billing platform. Machine-readable backbone for the flow visualization and the per-module READMEs in src/modules/<name>/README.md. `dependsOn` lists the runtime imports between modules (type-only imports excluded), as in the code.",
  "generated": "2026-11-15",
  "hierarchy": [
    "Organization",
    "Business",
    "Customer",
    "Subscription"
  ],
  "layers": [
    {
      "id": "kernel",
      "name": "Platform kernel",
      "color": "#64748b",
      "note": "src/platform/* — cross-cutting; no domain logic"
    },
    {
      "id": "foundation",
      "name": "Foundation modules",
      "color": "#0ea5e9",
      "note": "tenancy, auth, ledger, events, webhooks, audit, ops"
    },
    {
      "id": "catalog",
      "name": "Catalog & pricing",
      "color": "#8b5cf6",
      "note": "what you sell"
    },
    {
      "id": "customer",
      "name": "Customers & balances",
      "color": "#ec4899",
      "note": "the payer + wallet"
    },
    {
      "id": "billing",
      "name": "Subscriptions & billing",
      "color": "#f59e0b",
      "note": "the engine loop"
    },
    {
      "id": "payments",
      "name": "Payments & gateway",
      "color": "#10b981",
      "note": "money movement"
    },
    {
      "id": "tooling",
      "name": "Ops tooling",
      "color": "#ef4444",
      "note": "migration, transfer, time travel"
    }
  ],
  "kernel": [
    {
      "id": "platform.db",
      "file": "src/platform/db.ts",
      "role": "withTenant() RLS transaction; raw db for clock scans"
    },
    {
      "id": "platform.auth",
      "file": "src/platform/auth.ts",
      "role": "Bearer auth, org resolution, test/live partition"
    },
    {
      "id": "platform.idempotency",
      "file": "src/platform/idempotency.ts",
      "role": "Idempotency-Key middleware (fingerprint + replay)"
    },
    {
      "id": "platform.clock",
      "file": "src/platform/clock.ts + jobs.ts",
      "role": "durable billing clock (graphile-worker)"
    },
    {
      "id": "platform.ids",
      "file": "src/platform/ids.ts",
      "role": "publicId(prefix) for transactional resources"
    },
    {
      "id": "platform.secrets",
      "file": "src/platform/secrets.ts",
      "role": "AES-256-GCM encrypt/decrypt for gateway creds"
    },
    {
      "id": "platform.event-context",
      "file": "src/platform/event-context.ts",
      "role": "request-scoped source/actor for events + audit"
    },
    {
      "id": "platform.fixed",
      "file": "src/platform/fixed.ts",
      "role": "Fixed12 decimal arithmetic (bigint × 10^12) for meter rates and quantities"
    },
    {
      "id": "platform.ingest-rate",
      "file": "src/platform/ingest-rate.ts",
      "role": "per-organization usage ingest limit + X-RateLimit headers"
    }
  ],
