{
  "name": "@two-minute-billing/sdk",
  "version": "0.0.0",
  "description": "Typed, dependency-free TypeScript client for the Two Minute Billing API.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./openapi.json": "./openapi.json",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "openapi.json", "README.md", "LICENSE"],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gox-ai/two-minute-billing.git",
    "directory": "sdk"
  },
  "homepage": "https://github.com/gox-ai/two-minute-billing/tree/main/sdk#readme",
  "bugs": "https://github.com/gox-ai/two-minute-billing/issues",
  "keywords": ["billing", "subscriptions", "invoicing", "usage-based-billing", "sdk", "typescript"],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
