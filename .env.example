# Copy to .env and fill in. Full rationale for every variable lives in src/platform/config.ts.
#
# This is the one settings file for the whole repository. The API and worker read all of it. The
# dashboard and the docs server copy in only the keys their sections below list (allowlists in
# dashboard/root-env.mjs and docs-site/server/lib/root-env.ts, gated by verify:env-allowlist), so
# the database URL and the secrets never reach them. dashboard/.env.local still works as an
# optional override; the real environment wins over both. A worktree points DOTENV_CONFIG_PATH at
# the main checkout's .env.

DATABASE_URL=postgres://postgres:postgres@localhost:5432/tmbilling
# Production: DATABASE_URL logs in as a role that owns no table (deploy/README.md § tenant
# isolation), and migrations run as the owner named here. Unset, migrations use DATABASE_URL.
# MIGRATION_DATABASE_URL=postgres://owner:password@host:5432/tmbilling
# Local Postgres in docker-compose.yml — compose refuses to start rather than default these.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Which product this is: self_hosted (the default) or cloud (our hosted service). Sign-up, plans,
# the live-mode lock and account billing work only on cloud; their own settings below do nothing
# on self_hosted. Any other value refuses to boot. The API, worker, back-office and dashboard read
# this line. The docs site's edition is NUXT_PUBLIC_EDITION, set when it is BUILT (not here).
# TMBILLING_EDITION=self_hosted

# ── Self-host init (src/platform/selfhost/init.ts; deploy/docker writes these) ─────
# Owner login for migrations; the app's DATABASE_URL is the tmbilling_system login.
# MIGRATION_DATABASE_URL=postgres://owner:…@host:5432/tmbilling
# init creates or updates tmbilling_system with this password. external = you manage it.
# APP_DB_PASSWORD=
# TMBILLING_APP_ROLE=external
# The first organization, used only while the database has no users. Each takes <NAME>_FILE.
# TMBILLING_INIT_ADMIN_EMAIL=
# TMBILLING_INIT_ORG_NAME=
# TMBILLING_INIT_ADMIN_PASSWORD=
# TMBILLING_INIT_API_KEY=sk_live_…
# TRUE = the API and worker refuse to boot on a schema older than the code (the image sets it).
# TMBILLING_REQUIRE_SCHEMA=TRUE

PORT=4000
# 0.0.0.0 is what a container needs; 127.0.0.1 puts the socket behind a reverse proxy.
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Long random value — hashes and verifies API keys.
API_KEY_SECRET=change-me-to-a-long-random-string
# AES-256-GCM key for gateway credentials at rest. Min 32 chars, REQUIRED in production.
GATEWAY_CREDENTIALS_KEY=change-me-to-a-long-random-string-min-32-chars
# The OLD key during a rotation: set it, run `pnpm gateway:rotate-credentials --write`, remove it.
# GATEWAY_CREDENTIALS_KEY_PREVIOUS=

# Buyer-facing portal origin — used to compose the /portal/s/<token> exchange link.
PORTAL_BASE_URL=http://localhost:4100
# How long a hosted-checkout link stays usable. Reusable, unlike the single-use portal link.
# CHECKOUT_SESSION_TTL_HOURS=24
# Public base this API is reachable at; a tunnel origin in local dev. Must be publicly reachable.
# WEBHOOK_BASE_URL=
# Outbound webhooks (and the invoice logo fetch) refuse private and reserved addresses:
# localhost, 10/8, 172.16/12, 192.168/16, 169.254/16 (cloud metadata), 100.64/10, IPv6 ULA
# and link-local. Set TRUE for local dev with a receiver on localhost, or a self-hosted install
# whose receivers are on a private network. Leave it unset on a multi-tenant deployment.
WEBHOOK_ALLOW_PRIVATE_TARGETS=TRUE
# AI model price list: fetched twice a day into our own table (genai-prices, MIT). Point the URL
# at a mirror if you host one; MODEL_PRICES_SYNC=off for an air-gapped install.
# MODEL_PRICES_SOURCE_URL=https://raw.githubusercontent.com/pydantic/genai-prices/main/prices/new_data/v2/data_slim.json
# MODEL_PRICES_SYNC=on
# Production shape:
# DASHBOARD_BASE_URL=https://app.example.com
# PORTAL_BASE_URL=https://portal.example.com
# WEBHOOK_BASE_URL=https://api.example.com

# ── Provider credentials (adapters activate only when present) ──────────────
# STRIPE_TEST_SECRET_KEY=sk_test_...
# STRIPE_TEST_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# PAYPAL_TEST_BUSINESS_US_CLIENT_ID=
# PAYPAL_TEST_BUSINESS_US_CLIENT_SECRET=
# PAYPAL_TEST_BUSINESS_INDIA_CLIENT_ID=
# PAYPAL_TEST_BUSINESS_INDIA_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
# RAZORPAY_TEST_KEY_ID=rzp_test_...
# RAZORPAY_TEST_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# GOCARDLESS_TEST_ACCESS_TOKEN=
# GOCARDLESS_WEBHOOK_SECRET=
# BRAINTREE_TEST_MERCHANT_ID=
# BRAINTREE_TEST_PUBLIC_KEY=
# BRAINTREE_TEST_PRIVATE_KEY=
# AUTHORIZENET_TEST_API_LOGIN_ID=
# AUTHORIZENET_TEST_TRANSACTION_KEY=
# AUTHORIZENET_TEST_SIGNATURE_KEY=
# SQUARE_TEST_APPLICATION_ID=
# SQUARE_TEST_ACCESS_TOKEN=
# SQUARE_TEST_LOCATION_ID=
# SQUARE_TEST_SIGNATURE_KEY=
# MOLLIE_TEST_API_KEY=
# CASHFREE_TEST_APP_ID=
# CASHFREE_TEST_SECRET_KEY=
# CASHFREE_WEBHOOK_SECRET=
# ADYEN_TEST_API_KEY=
# ADYEN_TEST_CLIENT_KEY=
# ADYEN_TEST_MERCHANT_ACCOUNT=
# ADYEN_WEBHOOK_HMAC_KEY=
# CHECKOUT_TEST_SECRET_KEY=
# CHECKOUT_TEST_PUBLIC_KEY=
# CHECKOUT_TEST_PROCESSING_CHANNEL_ID=
# CHECKOUT_TEST_API_PREFIX=
# CHECKOUT_TEST_WEBHOOK_SECRET=
# CHECKOUT_TEST_ENTITY_ID=
# PAYU_TEST_KEY=
# PAYU_TEST_SALT=
# CYBERSOURCE_TEST_ORGANIZATION_ID=
# CYBERSOURCE_TEST_KEY_ID=
# CYBERSOURCE_TEST_SECRET_KEY=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
RAZORPAY_API_BASE=https://api.razorpay.com/v1
# Pin gateway-account public ids (`stripe=gwa_...`) so an import cannot orphan a registered
# webhook URL. Set to whatever the provider dashboards already point at.
# GATEWAY_ACCOUNT_IDS=

# ── Email / SMTP ────────────────────────────────────────────────────────────
# console | smtp | ses | esp. The deployment-wide relay; a business may override its own.
MAILER_PROVIDER=console
# Local stacks only: the console mailer also logs each email's text body, so sign-up and
# reset links can be followed without an inbox.
# MAILER_CONSOLE_BODY=TRUE
MAIL_FROM=billing@tmbilling.local
MAIL_FROM_NAME=tmbilling
# Only for MAILER_PROVIDER=smtp.
# SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=starttls
# SMTP_USERNAME=
# SMTP_PASSWORD=
# Only for MAILER_PROVIDER=ses. NOT named AWS_ACCESS_KEY_ID — those are the SDK's ambient
# vars and any other AWS client in the process would inherit them. Needs ses:SendRawEmail.
AWS_EMAIL_REGION=us-east-1
# AWS_EMAIL_KEY=
# AWS_EMAIL_SECRET=
# SES configuration set — the hook for bounce/complaint events via SNS.
# AWS_EMAIL_CONFIGURATION_SET=

# ── Object storage for merchant brand assets (Cloudflare R2) ────────────────
# All optional; the upload route refuses cleanly when unset.
# R2_ACCOUNT_ID=
# R2_BUCKET_NAME=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# Load-bearing: the bucket may be shared with another app; this prefix is the only separation.
R2_KEY_PREFIX=tmbilling
# Becomes businesses.logo_url, which is scheme-restricted — must be http(s).
# CDN_URL=https://assets.example.com
# Any other S3-compatible store (MinIO, AWS S3): set the endpoint and leave R2_ACCOUNT_ID unset.
# OBJECT_STORE_ENDPOINT=http://minio:9000
# OBJECT_STORE_REGION=auto
# OBJECT_STORE_FORCE_PATH_STYLE=FALSE

# ── Tax-ID (VAT number) validation ──────────────────────────────────────────
# noop records 'undetermined' without a lookup; vies performs a live EU lookup.
# Unset: vies when TMBILLING_EDITION=cloud, noop otherwise.
# TAX_ID_VALIDATOR=noop
VIES_API_BASE=https://ec.europa.eu/taxation_customs/vies/rest-api
# On timeout we record 'undetermined' rather than guessing.
VIES_TIMEOUT_MS=5000

# ── Google Cloud Logging ────────────────────────────────────────────────────
# ⚠ PRODUCTION: TMBILLING_EDITION=cloud refuses to boot unless this is TRUE, because the alert
# evaluator reaches a human through this sink. A self-hosted production deployment must set it
# explicitly, TRUE or FALSE (FALSE = your own log driver). Off, everything stays pino-to-stdout.
# The sink is OFF unless this is TRUE *and* a project id is set; config refuses to boot with
# one and not the other. An unreachable Google degrades to stdout and keeps billing.
CLOUD_LOGGING=FALSE
# GOOGLE_CLOUD_PROJECT_ID=
# Omit to use ambient ADC (GOOGLE_APPLICATION_CREDENTIALS, metadata server).
# GOOGLE_CLOUD_CREDENTIALS_PATH=./cloudlogging.json
GOOGLE_CLOUD_LOG_NAME=tmbilling
# Error Reporting GROUPS by this — pm2 sets it per process so a worker crash loop stays its own.
GOOGLE_CLOUD_SERVICE_CONTEXT=tmbilling
# Sink threshold, independent of LOG_LEVEL: chatty stdout locally, lean sink.
CLOUD_LOGGING_LEVEL=info
# CLOUD_PROVIDER=

# ── Worker / billing clock ──────────────────────────────────────────────────
# Job slots in ONE worker process — not a process count, not a queue count.
WORKER_CONCURRENCY=5
# Fallback poll; only matters when the LISTEN/NOTIFY connection drops.
WORKER_POLL_INTERVAL_MS=1000
# Job batching (graphile-worker 0.17+), off by default. Local queue size: start at concurrency + 1.
# WORKER_LOCAL_QUEUE_SIZE=6
# Batch job complete/fail writes within this many ms; -1 = one write per job.
# WORKER_JOB_BATCH_DELAY_MS=-1
# Must stay UNDER pm2's kill_timeout (35000) so we decide the outcome, not a SIGKILL mid-tick.
WORKER_SHUTDOWN_TIMEOUT_MS=25000
# The worker's /healthz (process only) and /readyz (dependencies). 0 disables. No auth — loopback.
WORKER_HEALTH_PORT=4002
WORKER_HEALTH_HOST=127.0.0.1
# Max rows one pass claims per tick; it reports `capped` and the next tick continues.
TICK_SCAN_LIMIT=500
# ⚠ WAS 90000, which is why the clock fell three days behind (2026-09-01) — longer than the 60s
# gap between ticks. If your .env still carries 90000 it OVERRIDES the fixed default. Change it.
TICK_PASS_BUDGET_MS=15000
# Budget for the WHOLE tick. 22 passes each individually in budget still sum past the cadence.
TICK_BUDGET_MS=45000
# Most rows ONE business may take from an egress pass — a share, not a rate limit.
TICK_FAIR_SHARE_PER_BUSINESS=50
# Renewals in flight. 1 = the serial loop it replaced, so a deploy changes nothing.
TICK_RENEWAL_CONCURRENCY=1
# Outbox rows in flight. 1 = serial. The relay binds before we do (an SES account starts ~14/s).
TICK_EGRESS_CONCURRENCY=1
# TRUE derives the per-business egress share from the live business count instead of the fixed
# cap above. OFF by default: it makes passes report `capped` where they never did, which alerts.
TICK_FAIR_SHARE_DYNAMIC=FALSE
# Postgres connections per process. Raise WITH the concurrency knobs; API and worker each get one.
DB_POOL_MAX=10
# Set for the WORKER only — a query that never returns is a tick that never ends.
# PG_STATEMENT_TIMEOUT_MS=30000

# ── Raising throughput: apply migration 0249 BEFORE deploying the code that writes duration_ms.
# Renewal 10 is derived from a measured 593ms Stripe mean (~253/tick, stays under TICK_SCAN_LIMIT).
# Do NOT set the egress value until `select percentile_disc(0.5) within group (order by
# duration_ms) from email_messages` has real rows — it has never been measured.
# TICK_RENEWAL_CONCURRENCY=10
# DB_POOL_MAX=20

# ── Circuit breaker — stop calling a dependency that is not answering ───────
# ON by default: the 2026-09-01 incident had every timeout and budget working as written.
CIRCUIT_BREAKER_ENABLED=TRUE
# Consecutive TRANSPORT faults before cut-off. 3, not 1 — one timeout is internet weather.
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
# Before ONE probe is let through. The breaker must not become the reason mail is late.
CIRCUIT_BREAKER_COOLDOWN_MS=60000
# Ceiling for the doubling cooldown: a day-long outage costs ~100 attempts, not ~17,000.
CIRCUIT_BREAKER_MAX_COOLDOWN_MS=900000

# ── API rate limiting ───────────────────────────────────────────────────────
# Per organization per minute; `organizations.rate_limit_per_minute` overrides per tenant.
RATE_LIMIT_PER_MINUTE=600
# Kill switch — FALSE skips the counter entirely, for a proxy that terminates limiting.
RATE_LIMIT_ENABLED=TRUE

# ── Unknown request parameters ──────────────────────────────────────────────
# reject (default): a body/query key the route does not declare → 400 "Unknown parameter: <path>".
# warn: log `request_unknown_parameters` with the route and keys, then ignore them (rollback).
API_UNKNOWN_PARAMS=reject

# ── Security posture ────────────────────────────────────────────────────────
# ALLOW_INSECURE_COOKIES and CSP_REPORT_ONLY are read by BOTH the API and the dashboard.
# Strips Secure from every cookie and suppresses HSTS. REFUSED in production.
# ALLOW_INSECURE_COOKIES=TRUE
# How many proxies sit in front — a fact about the deployment. REQUIRED in production.
# 0 = the socket faces the internet; 1 = one nginx. Too high believes a header a client forged.
# TRUST_PROXY_HOPS=1
# Cloudflare Turnstile server-side secret. Absent = the challenge is off.
# TURNSTILE_SECRET_KEY=
# LOGIN_ATTEMPT_RETENTION_DAYS=90
# SECURITY_EVENT_RETENTION_DAYS=365
# Days a support-filed 2FA reset waits for the owner to cancel it from the emailed link.
# MFA_RESET_WAIT_DAYS=3
# Shown on the sign-in code step and in account-security emails. Unset = "your administrator".
# SUPPORT_EMAIL=support@example.com
# Self-serve sign-up, Cloud only (TMBILLING_EDITION=cloud). A password sign-up answers "check
# your email" for every address and signs in only through the emailed link, so the form
# reveals no account.
# SIGNUP_ENABLED=TRUE
# New sign-ups start on the Free plan: live mode on, measured against its monthly limit by
# account billing. Off = a sign-up is an agreement, with no limit.
# SIGNUP_SANDBOX=TRUE
# Cloud with sign-up off: the sign-up page takes access requests. Each one is emailed here
# (unset = stored and listed in the back-office only) and posted to the Google Chat webhook
# LEAD_CHAT_WEBHOOK_URL (unset = OPS_ALERT_WEBHOOK_URL).
# SIGNUP_REQUEST_NOTIFY_TO=team@example.com
# LEAD_CHAT_WEBHOOK_URL=
# Most customers / subscriptions per TEST business. Unset: 1000 on Cloud, no limit on
# self-hosted. A number applies on any edition; 0 = no limit.
# TEST_BUSINESS_CUSTOMER_LIMIT=1000
# TEST_BUSINESS_SUBSCRIPTION_LIMIT=1000
# Screens new passwords against HIBP (k-anonymity, fails open). REQUIRED in production.
# PASSWORD_BREACH_CHECK=TRUE
# DEPRECATED: use Settings → Security → "Require two-factor authentication" per organization.
# Roles that MUST hold a second factor. Mandated roles get a session but no /v1/* until enrolled.
# MFA_REQUIRED_ROLES=owner,admin
# CSP_REPORT_ONLY=TRUE

# ── Limits for the UNAUTHENTICATED surface ──────────────────────────────────
# Per FIFTEEN MINUTES. 30/IP deviates from the standard's 10 on purpose — one address is not
# one person (NAT); the per-EMAIL axis is what survives a botnet.
# RATE_LIMIT_AUTH_PER_IP=30
# RATE_LIMIT_AUTH_PER_EMAIL=5
# Platform mail per minute per RECIPIENT — keyed on the victim, not the requester.
# RATE_LIMIT_MAIL_PER_RECIPIENT=3
# Image uploads per HOUR: profile photos per person, brand images per person and per organization.
# RATE_LIMIT_AVATAR_UPLOADS_PER_USER=10
# RATE_LIMIT_BRAND_UPLOADS_PER_USER=30
# RATE_LIMIT_BRAND_UPLOADS_PER_ORG=60
# Dashboard (operator session) requests per MINUTE per person; separate from the org API limit.
# RATE_LIMIT_SESSION_PER_MINUTE=1200
# Team invites per HOUR, per person and per organization.
# RATE_LIMIT_INVITES_PER_USER=20
# RATE_LIMIT_INVITES_PER_ORG=50
# Webhook resend/test sends per MINUTE (each is an inline POST to the subscriber).
# RATE_LIMIT_WEBHOOK_SENDS_PER_ENDPOINT=10
# RATE_LIMIT_WEBHOOK_SENDS_PER_ORG=30
# Ad hoc emails per HOUR, per business and per recipient.
# RATE_LIMIT_ADHOC_EMAILS_PER_BUSINESS=200
# RATE_LIMIT_ADHOC_EMAILS_PER_RECIPIENT=10
# Invoice collect/retry: per invoice per HOUR, per organization per MINUTE.
# RATE_LIMIT_COLLECTS_PER_INVOICE=10
# RATE_LIMIT_COLLECTS_PER_ORG=120
# Buyer coupon-code tries per FIFTEEN MINUTES, per checkout session and per address.
# RATE_LIMIT_COUPON_TRIES_PER_SESSION=10
# RATE_LIMIT_COUPON_TRIES_PER_IP=30
# A long lock is a denial-of-service weapon against any address an attacker knows.
# LOGIN_LOCKOUT_THRESHOLD=10
# LOGIN_LOCKOUT_MINUTES=15
# Idle timeout, and the absolute ceiling measured from sign-in and never extended.
# SESSION_IDLE_MINUTES=30
# SESSION_ABSOLUTE_TTL_HOURS=168

# ── Operator sign-in: Google ────────────────────────────────────────────────
# All three or none — config refuses to boot half-configured. Invite-only: Google authenticates
# a user who already holds a membership, so it can never create an account.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Must match a registered redirect URI EXACTLY — points at the API, not the dashboard.
# GOOGLE_REDIRECT_URI=http://localhost:4100/auth/google/callback
# DASHBOARD_BASE_URL=http://localhost:4100
# PASSWORD_RESET_TTL_MINUTES=30

# ── Operator sign-in: passkeys ──────────────────────────────────────────────
# Passkeys bind to the DASHBOARD's origin (where the browser is), not the API's. Leave all three
# unset in local dev: they derive from DASHBOARD_BASE_URL, else http://localhost:4100.
# Hostname passkeys are bound to; default = DASHBOARD_BASE_URL's hostname. Changing it invalidates every existing passkey.
# WEBAUTHN_RP_ID=billing.example.com
# Name the browser's passkey dialog shows; default "Two Minute Billing". Safe to change.
# WEBAUTHN_RP_NAME=Two Minute Billing
# Comma-separated origins allowed to finish a ceremony; default = DASHBOARD_BASE_URL's origin. Each must sit on WEBAUTHN_RP_ID.
# WEBAUTHN_ORIGINS=https://billing.example.com

# ── Dashboard (dashboard/) ──────────────────────────────────────────────────
# Only these keys reach the dashboard, plus TMBILLING_EDITION, ALLOW_INSECURE_COOKIES and
# CSP_REPORT_ONLY above. It holds no credential of its own: it forwards the operator's session.
# NEXT_PUBLIC_*, CSP_REPORT_ONLY and the HSTS header are fixed at `pnpm build`; rebuild after a
# change. The rest is read when `next start` starts.
# Where the dashboard reaches the API, server to server. Default http://localhost:4000.
# TMBILLING_API_URL=http://localhost:4000
# The API's origin as a BROWSER or a gateway sees it (the same value as WEBHOOK_BASE_URL).
# Unset in local dev is correct.
# TMBILLING_PUBLIC_API_URL=https://api.example.com
# Cloudflare Turnstile PUBLIC site key; pair it with TURNSTILE_SECRET_KEY above.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Google sign-in PUBLIC values, equal to GOOGLE_CLIENT_ID / GOOGLE_REDIRECT_URI above. Unset =
# the dashboard asks the API.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# NEXT_PUBLIC_GOOGLE_REDIRECT_URI=http://localhost:4100/auth/google/callback
# Account billing, Cloud only: where Settings → Billing reads the organization's plan, and its
# token (opens /v1/account_billing/* only, read server-side). Unset = no Billing page.
# ACCOUNT_BILLING_URL=http://127.0.0.1:4500
# ACCOUNT_BILLING_TOKEN=
# Google Analytics 4 on the sign-up pages only, and a server-side `sign_up` event when an account
# is created (Measurement Protocol). Both or neither; unset = no analytics anywhere in the app.
# Consent follows the `tmb-cookie-consent` cookie and the visitor's country (EU/EEA/UK/CH opt in).
# GA_MEASUREMENT_ID=G-XXXXXXXXXX
# GA_API_SECRET=
# ACCOUNT_BILLING_CONTACT_URL=https://example.com/contact

# ── Docs site server (docs-site/) ───────────────────────────────────────────
# Read by `node .output/server/index.mjs` at start (restart it after a change). Only these keys
# reach it. Prerendered pages fix NUXT_PUBLIC_* at BUILD time, so keep the build's values equal.
# /pricing: the API base and the business that sells the plans (biz_…).
# NUXT_PRICING_API_URL=http://localhost:4000
# NUXT_PRICING_BUSINESS=
# /contact: recipient, sender, and either Amazon SES over HTTPS (all three SES keys, an IAM key
# allowed ses:SendEmail; used first) or an SMTP URL (password URL-encoded). Use SES where the
# host blocks SMTP ports.
# NUXT_CONTACT_SES_REGION=
# NUXT_CONTACT_SES_KEY_ID=
# NUXT_CONTACT_SES_SECRET=
# NUXT_CONTACT_SMTP_URL=
# NUXT_CONTACT_TO=
# NUXT_CONTACT_FROM=
# Google Chat incoming webhook: each /contact message is also posted there. The URL is the
# credential. Unset = OPS_ALERT_WEBHOOK_URL. Sent when email or chat takes it.
# NUXT_CONTACT_CHAT_WEBHOOK_URL=
# /contact's bot check: both or neither.
# NUXT_TURNSTILE_SECRET=
# NUXT_PUBLIC_TURNSTILE_SITE_KEY=
# Sign in / Start for free links (the dashboard origin), and the canonical site origin.
# NUXT_PUBLIC_APP_URL=http://localhost:4100
# NUXT_PUBLIC_SITE_URL=

# ── Parity harness (scripts/parity) ─────────────────────────────────────────
# Drives the API at TMBILLING_API_URL (Dashboard section above).
TMBILLING_PARITY_BUSINESS_ID=
TMBILLING_PARITY_API_KEY=

# ── HubSpot app (optional) ──
# Your own public app in a HubSpot developer account. The redirect URI is the DASHBOARD
# callback and must match the app's redirect URLs exactly. Set all three or none.
HUBSPOT_APP_ID=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
# HUBSPOT_REDIRECT_URI=http://localhost:4100/integrations/hubspot/callback
# Production: HUBSPOT_REDIRECT_URI=https://app.example.com/integrations/hubspot/callback
# (and hubspot-app/src/hsprofile.production.json API_BASE_URL = the production API base; that file is not committed)
